# One NJU Mobile account per file. Copy this file once for every account.
# This name is only included in logs; do not use a phone number.
NJU_ACCOUNT_NAME=replace-with-account-name
NJU_PHONE=replace-with-nju-phone-number
NJU_PASSWORD=replace-with-nju-password

# Each account should normally use an API key scoped to a distinct Oblidog category.
OBLIDOG_URL=https://oblidog.example.com
OBLIDOG_API_KEY=replace-with-category-scoped-integration-api-key
