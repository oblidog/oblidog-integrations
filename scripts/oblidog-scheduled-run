#!/bin/sh
set -eu

integration="${1:?usage: oblidog-scheduled-run INTEGRATION}"
state_dir="${HOME}/.local/state/oblidog-integrations"
lock_path="$state_dir/${integration}.lock"
export TZ="${OBLIDOG_SCHEDULER_TIMEZONE:-Europe/Warsaw}"
mkdir -p "$state_dir"

timestamp() {
    date -u +%Y-%m-%dT%H:%M:%SZ
}

exec 9>"$lock_path"
if ! flock -n 9; then
    oblidog-scheduler-log scheduled_run_skipped "integration=$integration" reason=already_running
    exit 0
fi

triggered_at="$(timestamp)"
started_epoch="$(date +%s)"
oblidog-scheduler-log scheduled_run_started "integration=$integration" "triggered_at=$triggered_at"

child_pid=""
terminate() {
    if [ -n "$child_pid" ]; then
        kill -TERM "$child_pid" 2>/dev/null || true
        wait "$child_pid" || true
    fi
    finished_at="$(timestamp)"
    duration="$(( $(date +%s) - started_epoch ))"
    oblidog-scheduler-log scheduled_run_finished "integration=$integration" status=interrupted exit_code=143 "finished_at=$finished_at" "duration_seconds=$duration"
    exit 143
}
trap terminate INT TERM

oblidog-integrations "$integration" &
child_pid="$!"
set +e
wait "$child_pid"
exit_code="$?"
set -e
child_pid=""

finished_at="$(timestamp)"
duration="$(( $(date +%s) - started_epoch ))"
if [ "$exit_code" -eq 0 ]; then
    status="success"
else
    status="failure"
fi
oblidog-scheduler-log scheduled_run_finished "integration=$integration" "status=$status" "exit_code=$exit_code" "finished_at=$finished_at" "duration_seconds=$duration"
exit "$exit_code"
