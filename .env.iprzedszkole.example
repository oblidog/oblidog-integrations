# One iPrzedszkole account per file. The kindergarten is the portal database name.
IPRZEDSZKOLE_ACCOUNT_NAME=account-one
IPRZEDSZKOLE_KINDERGARTEN=replace-with-kindergarten-name
IPRZEDSZKOLE_LOGIN=replace-with-login
IPRZEDSZKOLE_PASSWORD=replace-with-password

OBLIDOG_URL=https://oblidog.example.com
OBLIDOG_API_KEY=replace-with-oblidog-api-key
OBLIDOG_INTEGRATION_KEY=iprzedszkole-child
# The iPrzedszkole category code is exactly four letters.
OBLIDOG_CATEGORY_CODE=IPRZ
