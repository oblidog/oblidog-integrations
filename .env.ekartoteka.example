# Oblidog API
OBLIDOG_URL=https://oblidog.example.com
OBLIDOG_API_KEY=replace-with-category-scoped-integration-api-key

# e-Kartoteka login. These values are sent as "username" and "password"
# to the e-Kartoteka token endpoint.
EKARTOTEKA_USERNAME=replace-with-e-kartoteka-username
EKARTOTEKA_PASSWORD=replace-with-e-kartoteka-password
